# Copy to backend/.env for local development. Never commit the real .env.

# --- Security ---
SECRET_KEY=change-me
JWT_SECRET=change-me-too
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Default (when unset): SQLite file at backend/instance/parking_guardian.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://pg_user:pg_password@localhost:5432/parking_guardian

# --- AI inference ---
# yolo: real models (backend/models/best.pt, last.pt + ../yolov5)
# mock: no torch needed. Verdict comes from the file name (see adapters/inference.py)
INFERENCE_BACKEND=yolo
WINDOW_CONF=0.25
STICKER_CONF=0.5

# --- Images ---
# IMAGE_STORAGE_DIR=C:/parking_guardian/capston/backend/storage
IMAGE_RETENTION_DAYS=90

# --- Devices ---
# Time zone assumed for device timestamps without an offset
DEVICE_NAIVE_TZ=Asia/Seoul
MACHINE_ONLINE_SECONDS=300

# --- Operations indicators ---
# Open violations older than this many hours count as left unattended
STALE_VIOLATION_HOURS=24

# --- Violation episodes (one parked vehicle = one violation) ---
# Devices upload a photo every minute. These decide when a violation starts and ends.
VIOLATION_CONFIRM_COUNT=2
VEHICLE_CLEAR_COUNT=3
EPISODE_GAP_MINUTES=10
